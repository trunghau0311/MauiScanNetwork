<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiScannetwork.Features.Diagnostics.DiagnosticsPage"
             Title="Diagnostics">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Dia chi IP (xxx.xxx.xxx.xxx)" FontSize="14" TextColor="Gray" />
            <Entry x:Name="TxtIp" Keyboard="Plain" FontSize="15" Placeholder="VD: 192.168.1.1" />

            <Label Text="Che do ping" FontSize="14" TextColor="Gray" />
            <Picker x:Name="PckMode" FontSize="14" Title="Chon che do ping">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Ping 4 goi tin (mac dinh)</x:String>
                        <x:String>Ping lien tuc (-t)</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="BtnPing"
                        Text="PING"
                        Clicked="OnPingClicked"
                        BackgroundColor="#1565C0"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="46" />
                <Button x:Name="BtnStop"
                        Grid.Column="1"
                        Text="STOP"
                        Clicked="OnStopClicked"
                        BackgroundColor="#B71C1C"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="46"
                        IsEnabled="False" />
            </Grid>

            <Button x:Name="BtnClear"
                    Text="XOA KET QUA"
                    Clicked="OnClearClicked"
                    BackgroundColor="#616161"
                    TextColor="White"
                    FontSize="13"
                    CornerRadius="8"
                    HeightRequest="38" />
        </VerticalStackLayout>

        <Frame Grid.Row="1" Padding="0" CornerRadius="8" BorderColor="#DDDDDD" HasShadow="false">
            <ScrollView x:Name="ResultScroll">
                <VerticalStackLayout x:Name="ResultStack" Spacing="3" Padding="10" />
            </ScrollView>
        </Frame>

    </Grid>

</ContentPage>