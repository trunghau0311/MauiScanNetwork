<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiScannetwork.Features.Network.NetworkPage"
             Title="SCANNETWORK"
             BackgroundColor="#F5F1E8">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="16">

            <!-- Header cổ điển: navy + vàng -->
            <Border BackgroundColor="#16335F"
                    Stroke="#C9A227"
                    StrokeThickness="0,0,0,4"
                    Padding="20,30"
                    StrokeShape="RoundRectangle 0,0,0,0">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Image Source="wifi_logo.png" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" />
                    <Label Text="SCANNERNETWORK"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           CharacterSpacing="3" />
                    <Label Text="KIEM TRA KET NOI MANG LAN"
                           FontSize="13"
                           TextColor="#C9A227"
                           CharacterSpacing="2"
                           HorizontalTextAlignment="Center" />
                    <BoxView HeightRequest="2" WidthRequest="120" Color="#C9A227" HorizontalOptions="Center" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,0,16,24" Spacing="16">

                <Button x:Name="BtnCheck"
                        Text="KIEM TRA"
                        Clicked="OnCheckClicked"
                        BackgroundColor="#C9A227"
                        TextColor="#16335F"
                        FontAttributes="Bold"
                        FontSize="18"
                        CharacterSpacing="2"
                        CornerRadius="6"
                        HeightRequest="52"
                        HorizontalOptions="Fill" />

                <Label x:Name="LblResult"
                       Text="Bam KIEM TRA de quet mang..."
                       FontSize="15"
                       TextColor="#6B6B6B"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Italic" />

                <VerticalStackLayout x:Name="NetworkDetailsPanel" IsVisible="False" Spacing="14">

                    <!-- WIFI -->
                    <Border BackgroundColor="#FFFEFA"
                            Stroke="#B8B0A0"
                            StrokeThickness="1"
                            Padding="0"
                            StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="8,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="0">
                            <BoxView Grid.Column="0" Grid.RowSpan="7" Color="#2E7DBD" />
                            <Grid Grid.Column="1" RowDefinitions="Auto" ColumnDefinitions="Auto,*" Margin="14,10,14,4">
                                <Label Text="WIFI"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#16335F"
                                       CharacterSpacing="2" />
                                <Label Grid.Column="1"
                                       x:Name="LblWifiIface"
                                       Text=""
                                       FontSize="12"
                                       TextColor="#8A8A8A"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Grid.Column="1" Grid.Row="1" x:Name="LblWifiIp" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="2" x:Name="LblWifiSubnet" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="3" x:Name="LblWifiGateway" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="4" x:Name="LblWifiDns" FontSize="14" TextColor="#333333" Margin="14,0,14,4" />
                            <Label Grid.Column="1" Grid.Row="5" x:Name="LblWifiStatus" FontSize="12" TextColor="#2E7DBD" Margin="14,0,14,10" />
                        </Grid>
                    </Border>

                    <!-- MOBILE DATA -->
                    <Border BackgroundColor="#FFFEFA"
                            Stroke="#B8B0A0"
                            StrokeThickness="1"
                            Padding="0"
                            StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="8,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="0">
                            <BoxView Grid.Column="0" Grid.RowSpan="7" Color="#3E7C4F" />
                            <Grid Grid.Column="1" RowDefinitions="Auto" ColumnDefinitions="Auto,*" Margin="14,10,14,4">
                                <Label Text="MOBILE DATA"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#16335F"
                                       CharacterSpacing="2" />
                                <Label Grid.Column="1"
                                       x:Name="LblMobileIface"
                                       Text=""
                                       FontSize="12"
                                       TextColor="#8A8A8A"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Grid.Column="1" Grid.Row="1" x:Name="LblMobileIp" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="2" x:Name="LblMobileSubnet" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="3" x:Name="LblMobileGateway" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="4" x:Name="LblMobileDns" FontSize="14" TextColor="#333333" Margin="14,0,14,4" />
                            <Label Grid.Column="1" Grid.Row="5" x:Name="LblMobileStatus" FontSize="12" TextColor="#3E7C4F" Margin="14,0,14,10" />
                        </Grid>
                    </Border>

                    <!-- USB-C / LAN -->
                    <Border BackgroundColor="#FFFEFA"
                            Stroke="#B8B0A0"
                            StrokeThickness="1"
                            Padding="0"
                            StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="8,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="0">
                            <BoxView Grid.Column="0" Grid.RowSpan="7" Color="#A05A2C" />
                            <Grid Grid.Column="1" RowDefinitions="Auto" ColumnDefinitions="Auto,*" Margin="14,10,14,4">
                                <Label Text="USB-C / LAN"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#16335F"
                                       CharacterSpacing="2" />
                                <Label Grid.Column="1"
                                       x:Name="LblUsbIface"
                                       Text=""
                                       FontSize="12"
                                       TextColor="#8A8A8A"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Grid.Column="1" Grid.Row="1" x:Name="LblUsbIp" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="2" x:Name="LblUsbSubnet" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="3" x:Name="LblUsbGateway" FontSize="14" TextColor="#333333" Margin="14,0,14,2" />
                            <Label Grid.Column="1" Grid.Row="4" x:Name="LblUsbDns" FontSize="14" TextColor="#333333" Margin="14,0,14,4" />
                            <Label Grid.Column="1" Grid.Row="5" x:Name="LblUsbStatus" FontSize="12" TextColor="#A05A2C" Margin="14,0,14,10" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>