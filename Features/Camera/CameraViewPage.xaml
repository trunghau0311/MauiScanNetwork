<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
             xmlns:local="clr-namespace:MauiScannetwork.Features.Camera"
             x:Class="MauiScannetwork.Features.Camera.CameraViewPage"
             Title="Camera Live"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ScrollView Orientation="Vertical" HorizontalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20" Spacing="16" HorizontalOptions="Fill">

            <!-- Camera IP Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Camera"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                <Label Text="{Binding Ip}"
                       FontSize="22"
                       FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
            </VerticalStackLayout>

            <!-- Vendor Selection -->
            <Label Text="HÃNG CAMERA"
                   FontSize="12" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"
                   Margin="0,0,0,2" />

            <Grid ColumnDefinitions="*,*">
                <Button x:Name="BtnHik"
                        Text="Hikvision"
                        Clicked="OnVendorClicked"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="20"
                        HeightRequest="42" />
                <Button Grid.Column="1"
                        x:Name="BtnProv"
                        Text="Provision"
                        Clicked="OnVendorClicked"
                        BackgroundColor="#00897B"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="20"
                        HeightRequest="42" />
            </Grid>

            <!-- Connection Info Card -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Thông tin kết nối"
                           FontSize="13" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light=#424242, Dark=#BDBDBD}" />

                    <Grid ColumnDefinitions="*,12,*">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Port"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                            <Entry x:Name="TxtPort"
                                   Keyboard="Numeric"
                                   FontSize="15"
                                   Placeholder="554"
                                   PlaceholderColor="{AppThemeBinding Light=#BDBDBD, Dark=#616161}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Username"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                            <Entry x:Name="TxtUser"
                                   FontSize="15"
                                   Placeholder="admin"
                                   PlaceholderColor="{AppThemeBinding Light=#BDBDBD, Dark=#616161}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Password"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="TxtPass"
                               IsPassword="True"
                               FontSize="15"
                               Placeholder="••••••••"
                               PlaceholderColor="{AppThemeBinding Light=#BDBDBD, Dark=#616161}" />
                        <Button Grid.Column="1"
                                x:Name="BtnShowPass"
                                Text="Hiện"
                                Clicked="OnShowPassClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                                TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="40"
                                WidthRequest="56"
                                VerticalOptions="Center" />
                    </Grid>

                    <Label x:Name="LblDefaultPass"
                           FontSize="12"
                           TextColor="#C62828"
                           IsVisible="False" />

                </VerticalStackLayout>
            </Frame>

            <!-- Engine Selection -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="Engine:"
                       FontSize="13" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light=#424242, Dark=#BDBDBD}"
                       VerticalOptions="Center" />
                <Picker x:Name="PckEngine"
                        Grid.Column="1"
                        FontSize="14"
                        SelectedIndexChanged="OnEngineChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>VLC</x:String>
                            <x:String>Hệ thống (VideoView)</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Grid>

            <!-- Connect Button -->
            <Button x:Name="BtnConnect"
                    Text="KẾT NỐI"
                    Clicked="OnConnectClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="12"
                    HeightRequest="50"
                    IsEnabled="False"
                    HorizontalOptions="Fill" />

            <!-- Status -->
            <Label x:Name="LblConnStatus"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"
                   LineBreakMode="WordWrap"
                   MaxLines="-1"
                   HorizontalTextAlignment="Center" />

            <!-- Video Player Frame -->
            <Frame x:Name="LiveFrame"
                   Padding="0"
                   CornerRadius="12"
                   IsVisible="False"
                   HeightRequest="260"
                   HasShadow="True"
                   HorizontalOptions="Fill"
                   IsClippedToBounds="False"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                   BackgroundColor="Black">
                <Grid HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0" Margin="0">
                    <local:VideoPlayerView x:Name="LiveView"
                                           BackgroundColor="Black"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"
                                           IsVisible="True" />
                    <vlc:MediaPlayerElement x:Name="VlcView"
                                            BackgroundColor="Black"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            IsVisible="False" />
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
