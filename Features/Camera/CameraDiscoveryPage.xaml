<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiScannetwork.Features.Camera"
             x:Class="MauiScannetwork.Features.Camera.CameraDiscoveryPage"
             Title="Camera Discovery"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,12" Spacing="4">
            <Label Text="Camera Discovery"
                   FontSize="24" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                   TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
            <Label Text="Quet camera IP trong LAN"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
        </VerticalStackLayout>

        <!-- Action Buttons -->
        <VerticalStackLayout Grid.Row="1" Padding="20,0" Spacing="10">

            <!-- 2 button chinh: Scan trong lop mang + Scan Unknown -->
            <Grid ColumnDefinitions="*,*">
                <Button x:Name="BtnScanSubnet"
                        Text="SCAN LỚP MẠNG"
                        Clicked="OnScanSubnetClicked"
                        BackgroundColor="#1565C0"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="12"
                        HeightRequest="52" />
                <Button Grid.Column="1"
                        x:Name="BtnScanUnknown"
                        Text="SCAN UNKNOWN"
                        Clicked="OnScanUnknownClicked"
                        BackgroundColor="#00897B"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="12"
                        HeightRequest="52" />
            </Grid>

            <!-- Mô tả 2 nút -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="●" TextColor="#1565C0" FontSize="8" VerticalOptions="Center" />
                <Label Text="Trong lớp mạng được cấp IP" FontSize="12" TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" VerticalOptions="Center" />
                <Label Text="●" TextColor="#00897B" FontSize="8" VerticalOptions="Center" />
                <Label Text="Unknown (SADP/IP Manager)" FontSize="12" TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button x:Name="BtnPreview"
                    Text="XEM LIVE (nhap IP thu cong)"
                    Clicked="OnPreviewClicked"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    TextColor="{StaticResource Primary}"
                    BorderColor="{StaticResource Primary}"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    HeightRequest="44"
                    HorizontalOptions="Fill" />

            <Button x:Name="BtnStop"
                    Text="STOP SCAN"
                    Clicked="OnStopClicked"
                    BackgroundColor="#C62828"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    HeightRequest="44"
                    HorizontalOptions="Fill"
                    IsVisible="False" />

        </VerticalStackLayout>

        <!-- Status + Filter -->
        <VerticalStackLayout Grid.Row="2" Padding="12,4" Spacing="6">
            <SearchBar x:Name="IpFilter"
                       Placeholder="Nhap IP de loc danh sach (VD: 192.168.64.30)..."
                       TextChanged="OnIpFilterTextChanged" />
            <Label x:Name="LblStatus"
                   Text="Chon che do scan ben tren"
                   FontSize="12"
                   Padding="8,0"
                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
        </VerticalStackLayout>

        <!-- Camera List -->
        <CollectionView x:Name="CameraList"
                        Grid.Row="3"
                        SelectionMode="None"
                        Margin="12,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8"
                                     Margin="0,40,0,0">
                    <Label Text="No cameras found"
                           FontSize="40"
                           HorizontalOptions="Center" />
                    <Label Text="Chua tim thay camera nao"
                           TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                           FontSize="15"
                           HorizontalOptions="Center" />
                    <Label Text="Chon SCAN LOP MANG hoac SCAN UNKNOWN de bat dau"
                           TextColor="{AppThemeBinding Light=#BDBDBD, Dark=#616161}"
                           FontSize="13"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:CameraDevice">
                    <Frame Margin="0,4"
                           Padding="14"
                           CornerRadius="12"
                           BorderColor="{AppThemeBinding Light=#E8E8E8, Dark=#2A2A2A}"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                           HasShadow="True">

                        <Grid ColumnDefinitions="*,Auto" RowSpacing="3">

                            <!-- Left: Camera Info -->
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding Ip}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}"
                                       LineBreakMode="NoWrap" />
                                <Label Text="{Binding Mac}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                                       LineBreakMode="NoWrap" />
                                <Label Text="{Binding Vendor}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#616161, Dark=#BDBDBD}" />
                                <Label Text="{Binding Info}"
                                       FontSize="12"
                                       TextColor="#00897B" />
                            </VerticalStackLayout>

                            <!-- Right: View Button -->
                            <Button Grid.Column="1"
                                    Text="Xem"
                                    Clicked="OnViewClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="38"
                                    WidthRequest="72"
                                    VerticalOptions="Center" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
