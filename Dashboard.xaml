<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiScannetwork.Dashboard"
             Title="Dashboard">

    <Grid
        Padding="20"
        RowDefinitions="*,Auto"
        ColumnDefinitions="*">

        <Image
            x:Name="GitHubLogo"
            Grid.Row="0"
            Source="dotnet_bot.png"
            Aspect="AspectFit"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            HeightRequest="200"
            WidthRequest="200" />

        <Label
            Grid.Row="1"
            Text="Scannetwork"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center"
            Margin="0,0,0,30" />

    </Grid>

</ContentPage>
